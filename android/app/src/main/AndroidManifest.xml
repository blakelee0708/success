<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="잘보이네"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- What makes this a launcher rather than an app that looks like
                 one. Without HOME + DEFAULT the phone never offers it in the
                 home-app chooser and pressing Home goes somewhere else.

                 `launchMode="singleTask"` and `stateNotNeeded` go with it:
                 pressing Home must bring the running launcher forward instead
                 of stacking a second copy, and the system has to be free to
                 kill and restart it without a saved state. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- Where a social sign-in hands the session back.

                 The guardian leaves for the phone's browser, signs in with
                 Kakao or Google there, and the provider redirects to this
                 scheme; supabase_flutter is listening and turns the link
                 into a session. Without this filter the browser finishes the
                 sign-in and then has nowhere to hand it to — the guardian is
                 left looking at a browser tab, signed in to nothing.

                 It must agree with `oauthRedirect` in
                 `guardian_auth_repository.dart` and with the project's
                 `uri_allow_list`. Three copies that cannot see each other;
                 `oauth_redirect_test.dart` compares this file against the
                 Dart one, the way `application_id_test` does for Gradle.

                 This arrives through `onNewIntent` like the home key does,
                 but `MainActivity` only forwards intents carrying
                 CATEGORY_HOME, so a callback is never mistaken for Home. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.jalboine.app"
                      android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <!-- Required to query activities that can process text, see:
             https://developer.android.com/training/package-visibility and
             https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

             In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Everything a home button resolves to. On Android 11 and up an app
             cannot see another app it has not declared here, so leaving one
             out does not degrade the tile — it makes it fail silently. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
        </intent>
        <!-- SOS hands a number to the dialer through url_launcher's tel: URI. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.APP_MESSAGING"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.APP_GALLERY"/>
        </intent>
        <!-- The fallbacks the gallery tile needs, because neither Samsung
             Gallery nor Google Photos answers APP_GALLERY. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="image/*"/>
        </intent>
        <!-- 문자 and 사진 fallbacks, for the same reason. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="smsto"/>
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.APP_BROWSER"/>
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>

        <!-- Named because Android has no category for either. -->
        <package android:name="com.kakao.talk"/>
        <package android:name="com.google.android.youtube"/>

        <!-- Every app with a launcher icon, so the senior can put one of their
             own on the home screen.

             This is what a launcher does, and it is deliberately NOT
             QUERY_ALL_PACKAGES: that permission is Play-restricted and its
             published list of acceptable uses is device search, antivirus,
             file managers and browsers — launchers are not on it. An intent
             query needs no declaration form and no review, and it already
             works: six <intent> entries above use <category> the same way and
             open real apps on a real phone. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>

        <!-- Resolved to answer "am I the current home app?", which is what the
             홈 화면으로 설정하기 prompt is keyed on. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>
</manifest>
